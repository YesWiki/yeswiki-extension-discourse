<span class="discourse-activity" style="display: inline-flex; align-items: flex-end; gap: .5em; line-height: 1;">
  <span class="discourse-activity__replies" role="img" aria-label="{{ _t('DISCOURSE_ACTIVITY_REPLIES', {n: replies}) }}" title="{{ _t('DISCOURSE_ACTIVITY_REPLIES', {n: replies}) }}" style="display: inline-flex; align-items: center; gap: .25em;">{{ icon('message-circle') }}<span aria-hidden="true">{{ replies }}</span></span>
  {{ sparkline|raw }}
</span>
